# Jarvis Environment Configuration
# Copy this file to .env and fill in values
# Updated: 2026-01-10 (post-security review)

# Workspace path (all file operations restricted to this directory)
JARVIS_WORKSPACE=C:\Users\YOUR_USERNAME\jarvis\workspace

# Ollama settings (local LLM)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Voice settings - STT (faster-whisper)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# Voice settings - TTS (edge-tts)
# Italian: it-IT-DiegoNeural, it-IT-ElsaNeural
# English: en-US-GuyNeural, en-GB-RyanNeural
TTS_VOICE=en-US-GuyNeural

# Push-to-talk hotkey (F9 recommended - no modifier keys)
VOICE_HOTKEY=f9

# Dashboard
DASHBOARD_PORT=5000
DASHBOARD_HOST=127.0.0.1

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Security settings
MAX_READ_SIZE=10485760
MAX_WRITE_SIZE=5242880
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# n8n integration (optional)
N8N_BASE_URL=http://localhost:5678

# Notes directory (Obsidian/Markdown)
NOTES_DIR=C:\Users\YOUR_USERNAME\Documents\Obsidian
